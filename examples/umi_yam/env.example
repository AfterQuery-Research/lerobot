# Non-secret cluster paths used by the UMI-to-YAM training recipes.
export UMI_YAM_LAB_ROOT=/path/to/lab-storage/user-root
export UMI_YAM_SCRATCH_ROOT=/path/to/scratch-storage/user-root
export UMI_YAM_VENV=/path/to/python-venv
export UMI_YAM_CODE_ROOT=/path/to/immutable/code-snapshot

# Optional: point at a readable, non-versioned file containing credentials such
# as WANDB_API_KEY. Prefer an existing credential store or `wandb login`.
# export UMI_YAM_ENV_FILE=/path/outside/repository/umi-yam-secrets.env
